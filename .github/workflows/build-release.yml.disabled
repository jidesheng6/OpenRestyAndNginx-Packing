name: 构建全平台安装包

on:
  schedule:
    - cron: "0 2 * * *"
  workflow_dispatch:
    inputs:
      version:
        description: "OpenResty 版本，例如 1.31.8.1。留空则自动检测最新版本。"
        required: false
        default: ""
      force:
        description: "即使 Release 已存在，也重新构建并覆盖安装包"
        required: false
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: openresty-release
  cancel-in-progress: false

jobs:
  resolve:
    name: 解析 OpenResty 版本
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.resolve.outputs.version }}
      build: ${{ steps.resolve.outputs.build }}
    steps:
      - name: 检测最新版本并检查 Release 是否已存在
        id: resolve
        env:
          GH_TOKEN: ${{ github.token }}
          INPUT_VERSION: ${{ github.event.inputs.version }}
          INPUT_FORCE: ${{ github.event.inputs.force }}
        run: |
          set -euo pipefail
          version="$(printf '%s' "$INPUT_VERSION" | tr -d '[:space:]')"
          force="$(printf '%s' "$INPUT_FORCE" | tr '[:upper:]' '[:lower:]')"
          if [ -z "$version" ]; then
            html="$(curl -fsSL --retry 5 --retry-delay 2 https://openresty.org/en/download.html)"
            version="$(printf '%s' "$html" \
              | grep -oE 'openresty-[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\.tar\.gz' \
              | head -n1 \
              | sed -E 's/^openresty-//; s/\.tar\.gz$//')"
          fi
          if [ -z "$version" ]; then
            echo "错误：无法确定最新的 OpenResty 版本" >&2
            exit 1
          fi
          code="$(curl -s -o /dev/null -w '%{http_code}' -r 0-0 "https://openresty.org/download/openresty-$version.tar.gz")"
          if [ "$code" != "200" ] && [ "$code" != "206" ]; then
            echo "错误：openresty-$version.tar.gz 无法下载（HTTP $code）" >&2
            exit 1
          fi
          if gh release view "v$version" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            if [ "$force" = "true" ]; then
              echo "Release v$version 已存在，已启用强制重建。"
              build=true
            else
              echo "Release v$version 已存在，跳过构建。"
              build=false
            fi
          else
            build=true
          fi
          echo "version=$version" >> "$GITHUB_OUTPUT"
          echo "build=$build" >> "$GITHUB_OUTPUT"
          echo "解析结果：版本 $version（build=$build）" >> "$GITHUB_STEP_SUMMARY"

  build-windows:
    name: 构建 Windows x64 安装程序
    needs: resolve
    if: needs.resolve.outputs.build == 'true'
    runs-on: windows-latest
    timeout-minutes: 60
    env:
      VERSION: ${{ needs.resolve.outputs.version }}
      OPENRESTY_VERSION: ${{ needs.resolve.outputs.version }}
    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 配置 MSYS2（MINGW64）
        uses: msys2/setup-msys2@v2
        with:
          msystem: MINGW64
          update: false
          install: >-
            base-devel
            mingw-w64-x86_64-toolchain
            perl
            make
            wget
            patch
            zip
            unzip

      - name: 缓存构建下载
        uses: actions/cache@v4
        with:
          path: .cache
          key: openresty-deps-${{ hashFiles('scripts/build-openresty.sh', 'scripts/build-linux.sh', 'patches/*') }}
          restore-keys: |
            openresty-deps-

      - name: 从源码构建 OpenResty
        shell: msys2 {0}
        run: bash scripts/build-openresty.sh

      - name: 整理安装载荷
        shell: pwsh
        run: ./scripts/stage-payload.ps1 -Version $env:VERSION

      - name: 安装 Inno Setup
        shell: pwsh
        run: |
          $url = "https://github.com/jrsoftware/issrc/releases/download/is-6_7_3/innosetup-6.7.3.exe"
          $installer = Join-Path $env:RUNNER_TEMP "innosetup.exe"
          Invoke-WebRequest -Uri $url -OutFile $installer -UseBasicParsing
          Start-Process -FilePath $installer -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART','/SP-' -Wait

      - name: 编译安装程序
        shell: pwsh
        run: |
          $candidates = @(
            "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe",
            "$env:ProgramFiles\Inno Setup 6\ISCC.exe",
            "$env:LOCALAPPDATA\Programs\Inno Setup 6\ISCC.exe"
          )
          $iscc = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1
          if (-not $iscc) { throw "未找到 ISCC.exe" }
          & $iscc "/DAppVersion=$env:VERSION" "installer\openresty.iss"
          if ($LASTEXITCODE -ne 0) { throw "Inno Setup 编译失败，退出代码 $LASTEXITCODE" }

      - name: 烟测安装程序
        shell: pwsh
        run: |
          $setup = Get-ChildItem "installer\Output\OpenResty-Setup-*.exe" | Select-Object -First 1
          if (-not $setup) { throw "未找到安装程序" }
          ./scripts/smoke-test.ps1 -InstallerPath $setup.FullName -Port 18080

      - name: 生成校验和
        shell: pwsh
        run: |
          $setup = Get-ChildItem "installer\Output\OpenResty-Setup-*.exe" | Select-Object -First 1
          $hash = (Get-FileHash $setup.FullName -Algorithm SHA256).Hash.ToLower()
          "$hash  $($setup.Name)" | Set-Content -Path "$($setup.FullName).sha256" -Encoding ASCII
          Get-Content "$($setup.FullName).sha256"

      - name: 上传构建产物
        uses: actions/upload-artifact@v4
        with:
          name: OpenResty-Setup-${{ needs.resolve.outputs.version }}-win64
          path: |
            installer/Output/OpenResty-Setup-*.exe
            installer/Output/OpenResty-Setup-*.exe.sha256
          if-no-files-found: error

  build-linux:
    name: 构建 Linux ${{ matrix.arch }} 安装包
    needs: resolve
    if: needs.resolve.outputs.build == 'true'
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x86_64
            goarch: amd64
            runner: ubuntu-24.04
            platform: linux/amd64
          - arch: aarch64
            goarch: arm64
            runner: ubuntu-24.04-arm
            platform: linux/arm64
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 90
    env:
      VERSION: ${{ needs.resolve.outputs.version }}
      OPENRESTY_VERSION: ${{ needs.resolve.outputs.version }}
      ARCH: ${{ matrix.arch }}
      PKG_GOARCH: ${{ matrix.goarch }}
      PLATFORM: ${{ matrix.platform }}
    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 缓存构建下载
        uses: actions/cache@v4
        with:
          path: .cache
          key: openresty-linux-${{ matrix.arch }}-${{ hashFiles('scripts/build-linux.sh', 'patches/*') }}
          restore-keys: |
            openresty-linux-${{ matrix.arch }}-

      - name: 在 AlmaLinux 8 中编译并打包
        run: |
          docker run --rm \
            --platform "$PLATFORM" \
            -v "$GITHUB_WORKSPACE:/work" \
            -w /work \
            -e OPENRESTY_VERSION \
            -e ARCH \
            -e PKG_GOARCH \
            -e DIST_DIR=/work/dist \
            almalinux:8 \
            bash scripts/build-linux.sh

      - name: 烟测 RPM、DEB 与绿色版
        run: bash scripts/smoke-test-linux.sh

      - name: 上传构建产物
        uses: actions/upload-artifact@v4
        with:
          name: OpenResty-Linux-${{ matrix.arch }}-${{ needs.resolve.outputs.version }}
          path: dist/*
          if-no-files-found: error

  release:
    name: 创建或更新 Release
    needs:
      - resolve
      - build-windows
      - build-linux
    if: needs.resolve.outputs.build == 'true'
    runs-on: ubuntu-latest
    env:
      VERSION: ${{ needs.resolve.outputs.version }}
    steps:
      - name: 下载全部构建产物
        uses: actions/download-artifact@v4
        with:
          path: dist
          merge-multiple: true

      - name: 生成 SHA256 校验和
        run: |
          set -euo pipefail
          cd dist
          find . -maxdepth 1 -type f ! -name '*.sha256' ! -name 'SHA256SUMS' -printf '%f\n' \
            | sort \
            | while read -r file; do
                sha256sum "$file"
              done > SHA256SUMS
          cat SHA256SUMS

      - name: 生成发布说明
        run: |
          set -euo pipefail
          cat > release-notes.md <<EOF
          OpenResty $VERSION Windows / Linux 安装包。

          ## Windows x64
          - 基于 OpenResty 官方源码包，在 windows-latest 上使用 MSYS2 / MinGW64 构建。
          - 安装程序为简体中文界面，使用 Inno Setup 制作；服务由 WinSW 注册和管理，服务名为 OpenResty。
          - 升级安装会替换程序文件，但保留 conf/、html/ 和 logs/ 目录。
          - 全新安装默认使用 80 端口，可在安装向导中修改；静默安装可传 /PORT=<端口>。
          - 安装完成后会自动打开测试页；可在“附加任务”中选择创建桌面快捷方式。

          ## Linux
          - 提供 RPM、DEB 和绿色版 tar.gz，支持 x86_64 与 aarch64。
          - 在 AlmaLinux 8 容器内构建，兼容 glibc 2.28 及更高版本（el8/9/10、Debian 10+、Ubuntu 20.04+）。
          - OpenSSL、PCRE2、zlib、libxcrypt 已静态内置；系统包额外依赖 perl、curl、tar、gzip（resty/opm 使用）。
          - RPM：sudo dnf install ./openresty-$VERSION-1.x86_64.rpm（arm64 为 aarch64.rpm）
          - DEB：sudo apt install ./openresty_$VERSION-1_amd64.deb（arm64 为 arm64.deb）
          - 绿色版：解压后执行 ./start.sh，默认监听 http://127.0.0.1:8080/
          - 系统包安装后：sudo systemctl enable --now openresty
          - 配置：/usr/local/openresty/nginx/conf/nginx.conf
          - 健康检查：http://127.0.0.1/healthz

          ## 校验
          - SHA256SUMS 包含所有产物的 SHA256 校验和。
          - Windows 安装包另有 .sha256 文件。

          上游更新日志：https://openresty.org/en/changes.html
          许可证：安装程序与打包脚本为 MIT；OpenResty 由 OpenResty Inc. 以 BSD 许可证发布。
          EOF

      - name: 创建或更新 GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          tag="v$VERSION"
          shopt -s nullglob
          assets=(dist/*)
          if [ ${#assets[@]} -eq 0 ]; then
            echo "错误：没有可上传的产物" >&2
            exit 1
          fi
          if gh release view "$tag" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            gh release upload "$tag" "${assets[@]}" --repo "$GITHUB_REPOSITORY" --clobber
            gh release edit "$tag" --repo "$GITHUB_REPOSITORY" \
              --title "OpenResty $VERSION Windows / Linux 安装包" \
              --notes-file release-notes.md
          else
            gh release create "$tag" "${assets[@]}" \
              --repo "$GITHUB_REPOSITORY" \
              --title "OpenResty $VERSION Windows / Linux 安装包" \
              --notes-file release-notes.md
          fi
